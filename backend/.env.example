FORGEAGENT_PROVIDER=openai
FORGEAGENT_MODEL=gpt-4.1-mini
FORGEAGENT_API_KEY=
FORGEAGENT_BASE_URL=https://api.openai.com/v1
FORGEAGENT_HOST=127.0.0.1
FORGEAGENT_PORT=8765
FORGEAGENT_DATA_DIR=
FORGEAGENT_WORKSPACE_DIR=
FORGEAGENT_USER_SKILLS_DIR=
FORGEAGENT_SEARCH_PROVIDER=auto
FORGEAGENT_TAVILY_API_KEY=
FORGEAGENT_HTTP_ALLOW_PRIVATE_NETWORK=false

# Linux sandbox: auto | bubblewrap | container
FORGEAGENT_SANDBOX_BACKEND=auto
FORGEAGENT_SANDBOX_HOME=
# Comma-separated IP/CIDR/hostnames allowed to read artifacts and open /rpc.
FORGEAGENT_TRUSTED_CLIENTS=127.0.0.0/8,::1/128,localhost,testclient
# Extra browser origins allowed to open the WebSocket (same-origin is implicit).
FORGEAGENT_ALLOWED_ORIGINS=
# Optional web UI directory; empty uses ../desktop/dist when it exists.
FORGEAGENT_WEB_DIR=
